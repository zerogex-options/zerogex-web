[Unit]
Description=ZeroGEX web cancellation alerts (emails the operator the reason behind every cancellation)
Documentation=https://github.com/zerogex-options/zerogex-web
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-web

# `make cancellation-alerts` shells through nvm to get the correct Node 22 binary
# (the script is a .mts that needs --experimental-strip-types). The Makefile
# target sources $HOME/.nvm/nvm.sh internally, so all we need here is HOME
# pointing at the user's home — the system PATH suffices for /usr/bin/make +
# /usr/bin/bash; node lands on PATH via nvm.sh at runtime.
Environment="HOME=/home/ubuntu"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# Sweeps audit_events for churn rows that have not been alerted yet and emails
# one message per cancellation. A tick with no new cancellations is two cheap
# indexed-free scans over a short trailing window and an early exit, which is
# why this can afford to run every 15 minutes: the whole point is to reach the
# member while they still have access.
ExecStart=/usr/bin/make -C /home/ubuntu/zerogex-web cancellation-alerts

# Resend + SQLite are the only outbound legs; cap so a hung HTTPS connect
# can't pile up overlapping timer fires. Below the 15m timer interval on
# purpose — a stuck run must be dead before the next one starts.
TimeoutStartSec=300

# Security hardening (mirrors the signup-alarm unit).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# RW exception: the auth DB directory. Unlike the read-only reporting timers,
# this one WRITES — the `cancellation_alert_sent` audit row is the idempotency
# latch, and without it every tick would re-email the same cancellations. The
# WAL sidecars need the directory writable too. Both known DB locations are
# listed with a leading '-' so a missing one is ignored rather than failing the
# unit; 098.cancellation-alerts adds a drop-in for a custom AUTH_DB_PATH.
# Update these if you move AUTH_DB_PATH.
ReadWritePaths=-/var/lib/zerogex
ReadWritePaths=-/home/ubuntu/zerogex-web/frontend/data

# Logging -> journald (view with: journalctl -u zerogex-web-cancellation-alerts)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-web-cancellation-alerts
