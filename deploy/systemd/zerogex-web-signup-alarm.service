[Unit]
Description=ZeroGEX web signup-rate alarm (emails the operator if registrations flatline)
Documentation=https://github.com/zerogex-options/zerogex-web
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-web

# `make signup-alarm` shells through nvm to get the correct Node 22 binary
# (the script is a .mts that needs --experimental-strip-types). The Makefile
# target sources $HOME/.nvm/nvm.sh internally, so all we need here is HOME
# pointing at the user's home — the system PATH suffices for /usr/bin/make +
# /usr/bin/bash; node lands on PATH via nvm.sh at runtime.
Environment="HOME=/home/ubuntu"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# Reads the auth DB and, during active hours, emails the operator when new
# registrations have flatlined. The active-hours gate + cooldown latch live
# in the script, so a normal hourly tick is a cheap COUNT and an early exit.
ExecStart=/usr/bin/make -C /home/ubuntu/zerogex-web signup-alarm

# Resend + SQLite are the only outbound legs; cap so a hung HTTPS connect
# can't pile up overlapping timer fires.
TimeoutStartSec=120

# Security hardening (mirrors the checkout-recovery unit).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# RW exception: the auth DB directory. The script only READS the users table,
# but opening the WAL database still touches the -wal/-shm sidecars, and the
# anti-spam latch (signup-alarm-state.json) is written next to the DB. Both
# known DB locations are listed with a leading '-' so a missing one is
# ignored rather than failing the unit; 096.signup-alarm adds a drop-in for a
# custom AUTH_DB_PATH. Update these if you move AUTH_DB_PATH.
ReadWritePaths=-/var/lib/zerogex
ReadWritePaths=-/home/ubuntu/zerogex-web/frontend/data

# Logging -> journald (view with: journalctl -u zerogex-web-signup-alarm)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-web-signup-alarm
