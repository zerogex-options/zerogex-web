[Unit]
Description=ZeroGEX wall-alert Discord / Slack delivery (Call/Put Wall hit / break / hold)
Documentation=https://github.com/zerogex-options/zerogex-web
After=network-online.target
Wants=network-online.target

# A non-zero exit means nothing could be delivered and waiting will not fix it
# (a missing admin token, an unreadable auth DB, or every post refused). Route
# that to an email; a member's own dead webhook is shown to them on the alerts
# page instead, and a transient outage retries on the next pass and exits 0.
OnFailure=zerogex-web-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-web

# `make wall-alerts-webhooks` shells through nvm for Node 22 (the script is a
# .mts that needs --experimental-strip-types). Same pattern as
# zerogex-web-wall-alerts-notify.service, whose twin this is: a separate unit so
# a Discord or Slack outage can never hold up email.
Environment="HOME=/home/ubuntu"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# Drains queued wall-alert webhook rows from the zerogex-oa outbox
# (/api/alerts/walls/internal/*, on 127.0.0.1:8000 with the admin token) and
# posts one message per member to their saved Discord or Slack webhook. An
# empty queue is one HTTP call and a silent exit.
ExecStart=/usr/bin/make -C /home/ubuntu/zerogex-web wall-alerts-webhooks

# Shorter than any useful backlog drain would need, longer than one pass with a
# rate-limit wait: a hung HTTPS connect must be dead before it can pile up.
TimeoutStartSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The script reads the auth DB (plan, deletion, the member's webhook) and makes
# one write to it: marking a webhook the provider says is gone. SQLite's WAL
# mode needs the directory writable anyway, and the worker keeps its small
# state file there (wall-alerts-webhooks.state.json). Both known DB locations,
# each with a leading '-' so a missing one is ignored;
# deploy/steps/091.wall-alerts-webhooks adds a drop-in for any other AUTH_DB_PATH.
ReadWritePaths=-/var/lib/zerogex
ReadWritePaths=-/home/ubuntu/zerogex-web/frontend/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-web-wall-alerts-webhooks
