[Unit]
Description=ZeroGEX web return-intent review digest timer (daily)

[Timer]
# Daily at 16:50 UTC (~12:50 PM ET in summer / 11:50 AM ET in winter).
#
# Daily, not weekly: unlike the win-back — whose cohort turns over on a ~monthly
# clock — this one answers a visit, and a reply that arrives a week late is not
# a reply. The script's own quiet window (--quiet-hours, default 24) already
# stops it writing to someone mid-session, so a daily tick is the fastest
# cadence that can actually deliver anything, and the cooldown
# (--cooldown-days, default 90) bounds how often one member can hear from it.
#
# The :50 minute keeps it clear of the hourly auth backup at :00, the
# trial-reminder timer at :15, the verify-reminder timer at :20, the
# verified-never-paid timer at :30, the win-back timer at :35, and the
# checkout-recovery timer at :45.
OnCalendar=*-*-* 16:50:00
# Spread load across deploys / coalesce if the box wakes many timers at once.
RandomizedDelaySec=5m
# If the box was down at the scheduled time, run as soon as it is back up.
Persistent=true

[Install]
WantedBy=timers.target
