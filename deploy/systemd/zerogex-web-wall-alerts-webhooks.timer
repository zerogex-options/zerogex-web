[Unit]
Description=ZeroGEX wall-alert Discord / Slack delivery timer (every 20 seconds)

[Timer]
# A wall alert is worth posting only while it is news, so this runs three
# times a minute, like the email timer, ten seconds after it so the two passes
# never start together. The script exits in one HTTP call when the queue is
# empty, and the backend expires anything left unsent after 20 minutes.
OnCalendar=*:*:15/20
AccuracySec=1s
# Keep runs off the :00 boundaries the minute timers use.
RandomizedDelaySec=2s
Persistent=true

[Install]
WantedBy=timers.target
