[Unit]
Description=ZeroGEX web Stripe invoice-history import timer (daily)

[Timer]
# Daily is the right cadence. A renewal is a once-a-month event per customer, so
# there is nothing new to see hourly — and the whole point of this table is that
# Stripe, not our audit log, is the source of truth for whether money moved.
#
# Every run re-scans the full paid-invoice list rather than a trailing window.
# Invoices are immutable once paid and the insert is an upsert keyed on invoice
# id, so a full scan is idempotent, costs a handful of requests, and leaves no
# gap for a missed run to fall into. 05:20 UTC keeps it clear of the 02:00/02:30
# jobs, the 04:40 Search Console sync and the hourly auth backup at :00.
OnCalendar=*-*-* 05:20:00
RandomizedDelaySec=10m
# If the box was down at the scheduled time, run as soon as it is back up.
Persistent=true

[Install]
WantedBy=timers.target
