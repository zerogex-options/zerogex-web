[Unit]
Description=ZeroGEX web Google Search Console daily-metrics sync
Documentation=https://github.com/zerogex-options/zerogex-web/blob/release/docs/daily-metrics.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-web

# `make sync-search-console` shells through nvm for Node 22 (the script is a
# .mts needing --experimental-strip-types), so HOME is all this unit has to
# provide; node lands on PATH via nvm.sh at runtime.
Environment="HOME=/home/ubuntu"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

ExecStart=/usr/bin/make -C /home/ubuntu/zerogex-web sync-search-console

# Two outbound HTTPS legs (token exchange, then one searchAnalytics query);
# cap so a hung connect can't overlap the next timer fire.
TimeoutStartSec=300

# Security hardening (mirrors the other job units).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# RW exception: the auth DB dir. The sync writes daily_external_metrics and
# then rebuilds daily_metrics in the same SQLite file the live PM2 process
# writes. Step 099 adds a drop-in for an AUTH_DB_PATH outside the repo.
ReadWritePaths=/home/ubuntu/zerogex-web/frontend/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-web-search-console

[Install]
WantedBy=multi-user.target
