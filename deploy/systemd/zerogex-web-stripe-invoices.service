[Unit]
Description=ZeroGEX web Stripe invoice-history import (renewal metrics)
Documentation=https://github.com/zerogex-options/zerogex-web/blob/release/docs/growth-metric-definitions.md
After=network-online.target
Wants=network-online.target

# A non-zero exit here would otherwise reach journald and nothing else. %n is
# this unit's own name, which the alert template turns into the subject line and
# the journal it quotes.
OnFailure=zerogex-web-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-web

# `make backfill-stripe-invoices` shells through nvm for Node 22 (the script is
# a .mts needing --experimental-strip-types), so HOME is all this unit has to
# provide; node lands on PATH via nvm.sh at runtime. STRIPE_SECRET_KEY is read
# by the script itself out of frontend/.env.local.
Environment="HOME=/home/ubuntu"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

ExecStart=/usr/bin/make -C /home/ubuntu/zerogex-web backfill-stripe-invoices

# Paginates the whole paid-invoice list — ~one HTTPS round trip per hundred
# invoices. Ten minutes is generous at any plausible size and still caps a hung
# connect well short of the next timer fire.
TimeoutStartSec=600

# Security hardening (mirrors the other job units).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# RW exception: the auth DB dir. The import writes stripe_invoice_history in the
# same SQLite file the live PM2 process uses — and nothing else in it. Step 099
# adds a drop-in when AUTH_DB_PATH lives outside the repo.
ReadWritePaths=/home/ubuntu/zerogex-web/frontend/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-web-stripe-invoices

[Install]
WantedBy=multi-user.target
