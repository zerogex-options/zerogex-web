[Unit]
Description=ZeroGEX web proactive card-expiry reminder emails
Documentation=https://github.com/zerogex-options/zerogex-web
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-web

# `make card-expiry-reminders` shells through nvm to get Node 22 (the script is
# a .mts needing --experimental-strip-types). The Makefile target sources
# $HOME/.nvm/nvm.sh internally, so all we need is HOME + a base PATH for
# /usr/bin/make + /usr/bin/bash; node lands on PATH via nvm.sh at runtime.
Environment="HOME=/home/ubuntu"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# STRIPE_SECRET_KEY is required (card expiries are read live from Stripe); the
# script reads it, RESEND_*, and NEXT_PUBLIC_APP_URL from frontend/.env.local.
ExecStart=/usr/bin/make -C /home/ubuntu/zerogex-web card-expiry-reminders YES=1

# Resend + Stripe are the only outbound legs; cap so a hung HTTPS connect can't
# pile up overlapping timer fires. Higher than the trial-reminder unit because
# this scans every active subscription's card.
TimeoutStartSec=900

# Security hardening (mirrors the trial-reminders unit).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# RW exception: the auth DB dir, because UPDATE users SET card_expiry_notified_ym
# and the audit_events INSERT both write to the same SQLite file as the live PM2
# writer. Update this if you change AUTH_DB_PATH in frontend/.env.local.
ReadWritePaths=/home/ubuntu/zerogex-web/frontend/data

# Logging -> journald (view with: journalctl -u zerogex-web-card-expiry)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-web-card-expiry
