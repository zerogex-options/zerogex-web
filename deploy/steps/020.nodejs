#!/bin/bash

# ==============================================
# Step 020: Node.js Installation
# ==============================================

set -e

# Re-point HOME when this step is run directly under `sudo`: $HOME is then
# /root, but the repo, nvm, pm2 and the auth DB all live in the invoking user's
# home, so every path below would resolve under /root and fail a precondition
# that is actually satisfied. deploy.sh does this for the steps it runs; doing
# it here too means a standalone `sudo ./deploy/steps/<step>` resolves the same
# paths. A no-op when already running as the owning user.
if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER:-}" != "root" ]; then
    STEP_SUDO_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    [ -n "$STEP_SUDO_HOME" ] && export HOME="$STEP_SUDO_HOME"
fi
[ -z "${HOME:-}" ] && export HOME="/home/ubuntu"

log "Node.js Installation"

# Check if nvm is already installed
if [ -d "$HOME/.nvm" ]; then
    log "  ℹ nvm already installed, skipping installation..."
else
    log "  → Installing nvm (Node Version Manager)..."
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash
    
    log "  → Loading nvm..."
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
fi

# Load nvm if not already loaded
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Install Node.js 22 (required for node:sqlite used by auth DB layer)
log "  → Installing Node.js 22..."
nvm install 22
nvm use 22
nvm alias default 22

# Verify installation
NODE_VERSION=$(node -v)
NPM_VERSION=$(npm -v)

log ""
log "Node.js installation complete!"
log ""
log "Summary:"
log "  ✓ nvm installed"
log "  ✓ Node.js version: $NODE_VERSION"
log "  ✓ npm version: $NPM_VERSION"
log ""
