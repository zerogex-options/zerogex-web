#!/bin/bash

# ==============================================
# Step 091: Wall-Alert Email Delivery Timer (systemd)
# ==============================================
#
# Installs and enables the wall-alert email worker
# (deploy/systemd/zerogex-web-wall-alerts-notify.{service,timer}). The timer
# fires every 20 seconds and runs `make wall-alerts-notify`, which drains
# queued Call/Put Wall alert emails from the zerogex-oa outbox:
#     GET  /api/alerts/walls/internal/queued?channel=email
#     POST /api/alerts/walls/internal/mark
# The outbox holds every member's alerts, so the backend requires BOTH the
# bearer key (ZEROGEX_API_TOKEN) and the admin token (ZEROGEX_ADMIN_TOKEN —
# the same secret API-key administration already uses).
#
# ORDER: the zerogex-oa side must be live first (make schema-apply, then the
# API restarted with the wall-alerts router). Before that the worker's GET
# 404s and every pass logs an error. Nothing is lost: it just has nothing to
# send yet.
#
# Idempotent — safe to re-run. Unit files are overwritten from the repo and
# `systemctl enable --now` is a no-op for an enabled timer.

set -e

# Re-point HOME when this step is run directly under `sudo` (same as the other
# steps): the repo, nvm and the auth DB live in the invoking user's home.
if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER:-}" != "root" ]; then
    STEP_SUDO_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    [ -n "$STEP_SUDO_HOME" ] && export HOME="$STEP_SUDO_HOME"
fi
[ -z "${HOME:-}" ] && export HOME="/home/ubuntu"

type log >/dev/null 2>&1 || log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

log "Wall-Alert Email Delivery Timer Setup"

APP_DIR="$HOME/zerogex-web"
SYSTEMD_SOURCE="$APP_DIR/deploy/systemd"
SYSTEMD_TARGET="/etc/systemd/system"
UNIT="zerogex-web-wall-alerts-notify"
ENV_FILE="$APP_DIR/frontend/.env.local"

# --- Preconditions ---------------------------------------------------
if [ ! -d "$SYSTEMD_SOURCE" ]; then
    log "  ✗ systemd source dir not found: $SYSTEMD_SOURCE"
    exit 1
fi
for f in "${UNIT}.service" "${UNIT}.timer"; do
    if [ ! -f "$SYSTEMD_SOURCE/$f" ]; then
        log "  ✗ missing unit file: $SYSTEMD_SOURCE/$f"
        exit 1
    fi
done
if [ -s "$HOME/.nvm/nvm.sh" ]; then
    log "  ✓ nvm present at $HOME/.nvm/nvm.sh"
else
    log "  ✗ nvm not found at $HOME/.nvm/nvm.sh — run step 020.nodejs first"
    exit 1
fi

# --- Env soft-check --------------------------------------------------
read_env() {
    grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"' | tr -d "'"
}
warn_missing_env() {
    if [ -z "$(read_env "$1")" ]; then
        log "  ⚠ $1 is unset in $ENV_FILE — timer will install but sends will error until set"
    else
        log "  ✓ $1 is set"
    fi
}
if [ -f "$ENV_FILE" ]; then
    warn_missing_env RESEND_API_KEY
    warn_missing_env RESEND_FROM_EMAIL
    warn_missing_env NEXT_PUBLIC_APP_URL
    warn_missing_env ZEROGEX_ADMIN_TOKEN
    warn_missing_env ZEROGEX_END_USER_TOKEN_SECRET
    if [ -n "$(read_env ZEROGEX_API_TOKEN)" ] || [ -n "$(read_env ZEROGEX_API_KEY)" ]; then
        log "  ✓ ZEROGEX_API_TOKEN (or legacy ZEROGEX_API_KEY) is set"
    else
        log "  ⚠ ZEROGEX_API_TOKEN / ZEROGEX_API_KEY unset in $ENV_FILE — sends will error until set"
    fi
else
    log "  ⚠ $ENV_FILE not found — step 030 should have created it"
fi

# --- Install the units -----------------------------------------------
log "  → Installing ${UNIT}.{service,timer}..."
sudo cp "$SYSTEMD_SOURCE/${UNIT}.service" "$SYSTEMD_TARGET/"
sudo cp "$SYSTEMD_SOURCE/${UNIT}.timer"   "$SYSTEMD_TARGET/"

# --- DB-dir drop-in for a custom AUTH_DB_PATH ------------------------
# The base unit already covers /var/lib/zerogex and frontend/data. SQLite in
# WAL mode needs the directory writable even for a read-only reader (the -shm
# sidecar), and the worker keeps its state file beside the DB, so a custom
# location gets a ReadWritePaths drop-in.
DROPIN_DIR="$SYSTEMD_TARGET/${UNIT}.service.d"
AUTH_DB_PATH_VALUE="$(read_env AUTH_DB_PATH)"
if [ -n "$AUTH_DB_PATH_VALUE" ]; then
    DB_DIR="$(dirname "$AUTH_DB_PATH_VALUE")"
    case "$DB_DIR" in
        /var/lib/zerogex|"$APP_DIR/frontend/data")
            log "  ✓ AUTH_DB_PATH dir ($DB_DIR) already covered by the base unit"
            sudo rm -f "$DROPIN_DIR/10-db-readwrite.conf" 2>/dev/null || true
            ;;
        *)
            log "  → AUTH_DB_PATH dir ($DB_DIR) is custom — writing ReadWritePaths drop-in"
            sudo mkdir -p "$DROPIN_DIR"
            printf '[Service]\nReadWritePaths=%s\n' "$DB_DIR" | sudo tee "$DROPIN_DIR/10-db-readwrite.conf" >/dev/null
            ;;
    esac
else
    log "  ℹ AUTH_DB_PATH not set — script defaults to frontend/data/auth.db (covered by base unit)"
fi

sudo systemctl daemon-reload

log "  → Enabling ${UNIT}.timer (every 20 seconds, Persistent=true)..."
if sudo systemctl enable --now "${UNIT}.timer" 2>/dev/null; then
    NEXT=$(systemctl list-timers --no-pager --no-legend "${UNIT}.timer" 2>/dev/null | awk '{print $1, $2}')
    log "     ✓ ${UNIT}.timer enabled (next run: ${NEXT:-unknown})"
else
    log "     ✗ ${UNIT}.timer failed to enable"
    exit 1
fi

# No real send here. To see the email before a member does:
#   cd ~/zerogex-web && make wall-alerts-notify PREVIEW_TO=you@example.com
# To see what the queue holds without sending:
#   cd ~/zerogex-web && make wall-alerts-notify DRY_RUN=1 VERBOSE=1

log ""
log "Wall-alert email timer setup complete!"
log ""
