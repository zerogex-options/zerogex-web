#!/bin/bash

# ==============================================
# Step 099: First-Month Plan Offer Timer (systemd)
# ==============================================
#
# Installs and enables the plan-offer timer (see
# deploy/systemd/zerogex-web-plan-offers.{service,timer}). The timer fires once
# a day and triggers `make plan-offers YES=1`, which emails each monthly member
# a few days before their FIRST renewal with the longer plans on their tier and
# what each costs per month (core/planOffer.ts). Once per subscription
# (users.plan_offer_email_sent_for), and never to anyone who opted out of
# marketing email.
#
# NOTE ON FIRST INSTALL: monthly members whose first renewal falls in the next
# 8 days are emailed on the first run. Preview who that is first:
#   cd ~/zerogex-web && make plan-offers DRY_RUN=1
#
# Idempotent — safe to re-run. The unit files are overwritten from the
# repo (they're version-controlled, so this is the desired behavior), and
# `systemctl enable --now` is a no-op for an already-enabled timer. No
# config file is written (the script reads RESEND_API_KEY,
# RESEND_FROM_EMAIL, NEXT_PUBLIC_APP_URL and ZEROGEX_END_USER_TOKEN_SECRET
# from frontend/.env.local, which earlier steps already manage).

set -e

# Re-point HOME when this step is run directly under `sudo`: $HOME is then
# /root, but the repo, nvm, pm2 and the auth DB all live in the invoking user's
# home, so every path below would resolve under /root and fail a precondition
# that is actually satisfied. deploy.sh does this for the steps it runs; doing
# it here too means a standalone `sudo ./deploy/steps/<step>` resolves the same
# paths. A no-op when already running as the owning user.
if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER:-}" != "root" ]; then
    STEP_SUDO_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    [ -n "$STEP_SUDO_HOME" ] && export HOME="$STEP_SUDO_HOME"
fi
[ -z "${HOME:-}" ] && export HOME="/home/ubuntu"

# Fallback log if this step is invoked directly (deploy.sh exports a log
# function, but operators sometimes run a single step in isolation to
# rotate units without re-running the whole pipeline).
type log >/dev/null 2>&1 || log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

log "First-Month Plan Offer Timer Setup"

# Resolve the owning user even when deploy.sh is invoked via sudo
# (deploy.sh re-points HOME to the SUDO_USER but not USER).
OWNER="${SUDO_USER:-$USER}"

APP_DIR="$HOME/zerogex-web"
SYSTEMD_SOURCE="$APP_DIR/deploy/systemd"
SYSTEMD_TARGET="/etc/systemd/system"
UNIT="zerogex-web-plan-offers"
ENV_FILE="$APP_DIR/frontend/.env.local"

# --- Preconditions ---------------------------------------------------
if [ ! -d "$SYSTEMD_SOURCE" ]; then
    log "  ✗ systemd source dir not found: $SYSTEMD_SOURCE"
    exit 1
fi
for f in "${UNIT}.service" "${UNIT}.timer"; do
    if [ ! -f "$SYSTEMD_SOURCE/$f" ]; then
        log "  ✗ missing unit file: $SYSTEMD_SOURCE/$f"
        exit 1
    fi
done

# nvm + Node 22 are installed by step 020.nodejs. The Makefile target
# sources $HOME/.nvm/nvm.sh at runtime, so presence here is enough — we
# don't need node on PATH for this step itself.
if [ -s "$HOME/.nvm/nvm.sh" ]; then
    log "  ✓ nvm present at $HOME/.nvm/nvm.sh"
else
    log "  ✗ nvm not found at $HOME/.nvm/nvm.sh — run step 020.nodejs first"
    exit 1
fi

# --- Env soft-check ---------------------------------------------------
# The script needs Resend creds to actually send mail; warn (don't fail)
# if they're empty, because step 036 seeds the keys with empty placeholders
# and the operator may not have filled them in yet. The timer still
# installs — if the keys land later, the next scheduled tick just works.
warn_missing_env() {
    local key="$1"
    local value
    value=$(grep -E "^${key}=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'")
    if [ -z "$value" ]; then
        log "  ⚠ $key is unset in $ENV_FILE — timer will install but sends will error until set"
    else
        log "  ✓ $key is set"
    fi
}
if [ -f "$ENV_FILE" ]; then
    warn_missing_env RESEND_API_KEY
    warn_missing_env RESEND_FROM_EMAIL
    warn_missing_env NEXT_PUBLIC_APP_URL
    # Signs the one-click unsubscribe link every offer carries.
    warn_missing_env ZEROGEX_END_USER_TOKEN_SECRET
else
    log "  ⚠ $ENV_FILE not found — step 030 should have created it"
fi

# --- Install + enable the units --------------------------------------
log "  → Installing ${UNIT}.{service,timer}..."
sudo cp "$SYSTEMD_SOURCE/${UNIT}.service" "$SYSTEMD_TARGET/"
sudo cp "$SYSTEMD_SOURCE/${UNIT}.timer"   "$SYSTEMD_TARGET/"

# --- Sandbox drop-in for AUTH_DB_PATH --------------------------------
# Derive the writable DB dir from .env.local so the sandbox stays sealed
# but the SQLite UPDATE actually lands wherever the operator points the
# DB. Without this, ProtectSystem=strict silently blocks the latch write
# whenever AUTH_DB_PATH lives outside the repo (e.g. /var/lib/zerogex):
# the Resend HTTPS call succeeds, the UPDATE errors as readonly, and the
# next tick re-sends. Drop-in (vs. editing the version-controlled
# .service file) keeps the repo defaults clean and lets each environment
# carry its own ReadWritePaths addition.
DROPIN_DIR="$SYSTEMD_TARGET/${UNIT}.service.d"
DROPIN="$DROPIN_DIR/auth-db-path.conf"
AUTH_DB_PATH=""
if [ -f "$ENV_FILE" ]; then
    AUTH_DB_PATH=$(grep -E "^AUTH_DB_PATH=" "$ENV_FILE" 2>/dev/null \
        | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'")
fi
if [ -n "$AUTH_DB_PATH" ] && [[ "$AUTH_DB_PATH" == /* ]]; then
    AUTH_DB_DIR=$(dirname "$AUTH_DB_PATH")
    log "  → Writing sandbox drop-in (ReadWritePaths=$AUTH_DB_DIR)..."
    sudo mkdir -p "$DROPIN_DIR"
    sudo tee "$DROPIN" >/dev/null <<EOF
[Service]
ReadWritePaths=$AUTH_DB_DIR
EOF
    log "     ✓ drop-in installed at $DROPIN"
else
    if [ -f "$DROPIN" ]; then
        log "  → Removing stale drop-in (AUTH_DB_PATH unset or relative)..."
        sudo rm -f "$DROPIN"
        sudo rmdir "$DROPIN_DIR" 2>/dev/null || true
    fi
    log "  → AUTH_DB_PATH absolute path unset; using unit-default ReadWritePaths"
fi

sudo systemctl daemon-reload

log "  → Enabling ${UNIT}.timer (daily, Persistent=true)..."
if sudo systemctl enable --now "${UNIT}.timer" 2>/dev/null; then
    NEXT=$(systemctl list-timers --no-pager --no-legend "${UNIT}.timer" 2>/dev/null | awk '{print $1, $2}')
    log "     ✓ ${UNIT}.timer enabled (next run: ${NEXT:-unknown})"
else
    log "     ✗ ${UNIT}.timer failed to enable"
    exit 1
fi

# Deliberately NO test run: the service's ExecStart is the real
# YES=1 send path. A dry-run smoke test would need a different ExecStart
# (or operator-invoked `make plan-offers DRY_RUN=1`), so we let the
# first scheduled tick be the validation. journalctl shows the result.

log ""
log "Plan offer timer setup complete!"
log ""
log "Summary:"
log "  ✓ ${UNIT}.timer enabled (daily at 15:20 UTC, Persistent=true catches missed runs)"
log "  ✓ Monthly members offered annual / quarterly 1-8 days before their first renewal"
log "  ✓ Idempotent: users.plan_offer_email_sent_for latches per subscription"
log ""
log "Useful commands:"
log "  • systemctl list-timers ${UNIT}.timer                              - next/last run"
log "  • cd $APP_DIR && make plan-offers DRY_RUN=1                    - preview eligible users (no send)"
log "  • sudo systemctl start ${UNIT}.service                             - fire the send loop now"
log "  • journalctl -u ${UNIT} -n 50                                       - recent send logs"
log "  • cd $APP_DIR && make plan-offers PREVIEW_TO=you@example.com   - render + send one sample email"
