#!/bin/bash

# ==============================================
# Step 040: PM2 Process Manager Setup
# ==============================================

set -euo pipefail

# Re-point HOME when this step is run directly under `sudo`: $HOME is then
# /root, but the repo, nvm, pm2 and the auth DB all live in the invoking user's
# home, so every path below would resolve under /root and fail a precondition
# that is actually satisfied. deploy.sh does this for the steps it runs; doing
# it here too means a standalone `sudo ./deploy/steps/<step>` resolves the same
# paths. A no-op when already running as the owning user.
if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER:-}" != "root" ]; then
    STEP_SUDO_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    [ -n "$STEP_SUDO_HOME" ] && export HOME="$STEP_SUDO_HOME"
fi
[ -z "${HOME:-}" ] && export HOME="/home/ubuntu"

# Fallback log if this step is invoked directly.
type log >/dev/null 2>&1 || log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

log "PM2 Process Manager Setup"

# Load Node via nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
nvm use 22

# Configurable values for standalone or co-hosted deployment
APP_NAME="${WEB_PM2_NAME:-zerogex-web}"
APP_DIR="${WEB_APP_DIR:-$HOME/zerogex-web/frontend}"
WEB_PORT="${WEB_PORT:-3000}"
REPO_ROOT="$(dirname "$APP_DIR")"
ECOSYSTEM_FILE="$REPO_ROOT/ecosystem.config.js"

log "  → App name: $APP_NAME"
log "  → App dir: $APP_DIR"
log "  → Port: $WEB_PORT"
log "  → Ecosystem file: $ECOSYSTEM_FILE"

# Install PM2 under the active Node (v22). We check `npm ls -g` instead of
# `command -v pm2` so a stale system-wide pm2 (e.g. from `sudo npm install -g`
# under a different Node) doesn't make us skip installing the nvm-scoped copy
# and silently re-introduce a Node-version mismatch between pm2 and the app.
if ! npm ls -g --depth=0 pm2 >/dev/null 2>&1; then
  log "  → Installing PM2 under Node $(node -v)..."
  npm install -g pm2
else
  log "  ℹ PM2 already installed under Node $(node -v)"
fi

# Restart process idempotently using the checked-in ecosystem config
if [ ! -f "$ECOSYSTEM_FILE" ]; then
  log "  ✗ $ECOSYSTEM_FILE not found — expected at repo root"
  exit 1
fi

# Pin the BFF process's Node interpreter to the absolute v22 path so PM2
# doesn't rely on the calling shell's PATH at `pm2 start` time. Without
# this pin, invoking `pm2 start ecosystem.config.js` from a shell that
# hasn't done `nvm use 22` (the system default on bare EC2 Ubuntu is
# Node 20) silently spawns the BFF on Node 20, where node:sqlite is
# missing and the auth proxy middleware fails to load — every page
# renders 500 while /api/* still returns 200. ecosystem.config.js reads
# this env var and passes it to PM2 as `interpreter`.
NODE22_BIN="$(command -v node)"
case "$NODE22_BIN" in
  */v22.*/bin/node) : ;;
  *)
    log "  ✗ Resolved node interpreter is not v22: ${NODE22_BIN:-<not found>}"
    log "    Re-run 020.nodejs to install Node 22, or check nvm aliases."
    exit 1
    ;;
esac
export PM2_NODE_INTERPRETER="$NODE22_BIN"
log "  → Pinning BFF interpreter: $PM2_NODE_INTERPRETER"

# Refuse to (re)start the BFF on a 22.x older than the last 22.x security
# release. This exits before the `pm2 delete` below, so an unpatched box keeps
# serving while 020.nodejs is re-run. 22.23.4 is the Oct 21 2026 release
# (Brotli decoder RCE, CVE-2026-111497); raise it when the next one ships.
NODE_MIN_PATCHED="22.23.4"
NODE22_VERSION="$(node -v)"
NODE22_VERSION="${NODE22_VERSION#v}"
if [ "$(printf '%s\n' "$NODE_MIN_PATCHED" "$NODE22_VERSION" | sort -V | head -n1)" != "$NODE_MIN_PATCHED" ]; then
  log "  ✗ Node $NODE22_VERSION is older than $NODE_MIN_PATCHED, the last 22.x security release"
  log "    Re-run 020.nodejs to install the newest Node 22, then this step."
  exit 1
fi

# After a Node upgrade the PM2 daemon is still running on the old binary:
# `pm2 delete` and `pm2 start` below reuse it, and only the app's interpreter
# moves. Stop it, so the next pm2 command spawns a fresh daemon on this Node
# (PM2 modules such as pm2-logrotate come back with it). The app is down from
# here until `pm2 start` below, a few seconds. Not `pm2 update`: on prod it
# restored the app on the old interpreter and then never exited.
PM2_PID_FILE="${PM2_HOME:-$HOME/.pm2}/pm2.pid"
if [ -s "$PM2_PID_FILE" ]; then
  PM2_DAEMON_NODE="$(readlink "/proc/$(cat "$PM2_PID_FILE")/exe" 2>/dev/null || true)"
  if [ -n "$PM2_DAEMON_NODE" ] && [ "$PM2_DAEMON_NODE" != "$(readlink -f "$NODE22_BIN")" ]; then
    log "  → PM2 daemon runs on $PM2_DAEMON_NODE; restarting it on Node $NODE22_VERSION"
    pm2 kill
  fi
fi

cd "$REPO_ROOT"
log "  → Restarting PM2 app: $APP_NAME"
pm2 delete "$APP_NAME" 2>/dev/null || true
PORT="$WEB_PORT" pm2 start "$ECOSYSTEM_FILE"

# Persist PM2 config and boot startup
log "  → Saving PM2 process list"
pm2 save
PM2_STARTUP=$(pm2 startup | grep "sudo env PATH" || true)
if [ -n "$PM2_STARTUP" ]; then
  log "  → Configuring PM2 startup"
  eval "$PM2_STARTUP"
else
  log "  ℹ PM2 startup already configured"
fi

sleep 2
log "  → PM2 status"
pm2 status "$APP_NAME"

log ""
log "PM2 setup complete!"
log "Summary:"
log "  ✓ PM2 ready"
log "  ✓ App '$APP_NAME' running on port $WEB_PORT"
log "  ✓ PM2 saved + startup configured"
