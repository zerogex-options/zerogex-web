#!/bin/bash

# ==============================================
# Step 099: Stripe Invoice History Import (systemd)
# ==============================================
#
# Installs and enables the daily Stripe invoice import (see
# deploy/systemd/zerogex-web-stripe-invoices.{service,timer}). The timer fires
# once a day and runs `make backfill-stripe-invoices`, which lists paid invoices
# from Stripe into the `stripe_invoice_history` table behind the renewal metrics
# on Admin -> Monitoring -> Growth.
#
# WHY IT NEEDS A TIMER. A renewal is money moving a second time, and it has to be
# SEEN rather than inferred from access having lasted about a month. The app's
# own `stripe_invoice_paid` audit rows only start when that event type shipped,
# so Stripe — not the audit log — is the source of truth for the renewal ladder.
# Keeping this table current is what stops customers drifting into the
# "unobservable" bucket as their renewals come due.
#
# READ-ONLY against Stripe: it lists invoices and writes one analytics table. It
# touches no user, subscription, tier or access state, and sends no email.
# Idempotent — invoice_id is the primary key and every run upserts, so a re-run
# adds only what is new.
#
# Idempotent as a deploy step too — safe to re-run. Unit files are overwritten
# from the repo (they are version-controlled, so that is the desired behavior)
# and `systemctl enable --now` is a no-op for an already-enabled timer.
#
# Credentials are NOT provisioned here. The script reads STRIPE_SECRET_KEY from
# frontend/.env.local, the same key the app already uses. Without it the script
# exits non-zero, so this step warns and skips the smoke test rather than
# installing a timer that would alarm every morning.

set -e

# Re-point HOME when this step is run directly under `sudo`: $HOME is then
# /root, but the repo, nvm, pm2 and the auth DB all live in the invoking user's
# home, so every path below would resolve under /root and fail a precondition
# that is actually satisfied. deploy.sh does this for the steps it runs; doing
# it here too means a standalone `sudo ./deploy/steps/<step>` resolves the same
# paths. A no-op when already running as the owning user.
if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER:-}" != "root" ]; then
    STEP_SUDO_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    [ -n "$STEP_SUDO_HOME" ] && export HOME="$STEP_SUDO_HOME"
fi
[ -z "${HOME:-}" ] && export HOME="/home/ubuntu"

# Fallback log if this step is invoked directly (deploy.sh exports a log
# function, but operators sometimes run a single step in isolation).
type log >/dev/null 2>&1 || log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

log "Stripe Invoice History Import Timer Setup"

OWNER="${SUDO_USER:-$USER}"
APP_DIR="$HOME/zerogex-web"
SYSTEMD_SOURCE="$APP_DIR/deploy/systemd"
SYSTEMD_TARGET="/etc/systemd/system"
UNIT="zerogex-web-stripe-invoices"
ENV_FILE="$APP_DIR/frontend/.env.local"

# --- Preconditions ---------------------------------------------------
if [ ! -d "$SYSTEMD_SOURCE" ]; then
    log "  ✗ systemd source dir not found: $SYSTEMD_SOURCE"
    exit 1
fi
for f in "${UNIT}.service" "${UNIT}.timer"; do
    if [ ! -f "$SYSTEMD_SOURCE/$f" ]; then
        log "  ✗ missing unit file: $SYSTEMD_SOURCE/$f"
        exit 1
    fi
done

if [ -s "$HOME/.nvm/nvm.sh" ]; then
    log "  ✓ nvm present at $HOME/.nvm/nvm.sh"
else
    log "  ✗ nvm not found at $HOME/.nvm/nvm.sh — run step 020.nodejs first"
    exit 1
fi

# --- Env soft-check ---------------------------------------------------
read_env() {
    grep -E "^${1}=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'"
}

STRIPE_KEY=""
if [ -f "$ENV_FILE" ]; then
    STRIPE_KEY=$(read_env STRIPE_SECRET_KEY)
    if [ -n "$STRIPE_KEY" ]; then
        log "  ✓ STRIPE_SECRET_KEY is set"
    else
        log "  ⚠ STRIPE_SECRET_KEY unset — timer installs, imports fail until it is set"
    fi
else
    log "  ⚠ $ENV_FILE not found — step 030 should have created it"
fi

# --- Install + enable the units --------------------------------------
log "  → Installing ${UNIT}.{service,timer}..."
sudo cp "$SYSTEMD_SOURCE/${UNIT}.service" "$SYSTEMD_TARGET/"
sudo cp "$SYSTEMD_SOURCE/${UNIT}.timer"   "$SYSTEMD_TARGET/"

# --- Sandbox drop-in ---------------------------------------------------
# ProtectSystem=strict seals the filesystem, so the SQLite write needs its
# directory listed explicitly whenever AUTH_DB_PATH lives outside the repo
# (e.g. /var/lib/zerogex). Same drop-in pattern as steps 085 and 099.search-console.
DROPIN_DIR="$SYSTEMD_TARGET/${UNIT}.service.d"
DROPIN="$DROPIN_DIR/auth-db-path.conf"
AUTH_DB_PATH=""
if [ -f "$ENV_FILE" ]; then
    AUTH_DB_PATH=$(read_env AUTH_DB_PATH)
fi
if [ -n "$AUTH_DB_PATH" ] && [[ "$AUTH_DB_PATH" == /* ]]; then
    AUTH_DB_DIR=$(dirname "$AUTH_DB_PATH")
    log "  → Writing sandbox drop-in (ReadWritePaths=$AUTH_DB_DIR)..."
    sudo mkdir -p "$DROPIN_DIR"
    sudo tee "$DROPIN" >/dev/null <<EOF
[Service]
ReadWritePaths=$AUTH_DB_DIR
EOF
    log "     ✓ drop-in installed at $DROPIN"
else
    if [ -f "$DROPIN" ]; then
        log "  → Removing stale drop-in (AUTH_DB_PATH unset or relative)..."
        sudo rm -f "$DROPIN"
        sudo rmdir "$DROPIN_DIR" 2>/dev/null || true
    fi
    log "  → AUTH_DB_PATH absolute path unset; using unit-default ReadWritePaths"
fi

sudo systemctl daemon-reload

log "  → Enabling ${UNIT}.timer (daily 05:20 UTC, Persistent=true)..."
if sudo systemctl enable --now "${UNIT}.timer" 2>/dev/null; then
    NEXT=$(systemctl list-timers --no-pager --no-legend "${UNIT}.timer" 2>/dev/null | awk '{print $1, $2}')
    log "     ✓ ${UNIT}.timer enabled (next run: ${NEXT:-unknown})"
else
    log "     ✗ ${UNIT}.timer failed to enable"
    exit 1
fi

# --- Smoke test --------------------------------------------------------
# DRY_RUN proves the key works and invoices are reachable without writing a row,
# which is exactly the setup mistake worth catching at deploy time rather than at
# 05:20. LIMIT keeps it to one page.
if [ -n "$STRIPE_KEY" ]; then
    log "  → Smoke test (DRY_RUN=1, first 20 invoices)..."
    if sudo -u "$OWNER" -H bash -lc "cd '$APP_DIR' && make backfill-stripe-invoices DRY_RUN=1 LIMIT=20" 2>&1 | sed 's/^/       /'; then
        log "     ✓ Stripe credentials and invoice access look good"
    else
        log "     ⚠ smoke test failed — check the message above; the timer is still installed"
    fi
else
    log "  → Skipping smoke test (STRIPE_SECRET_KEY not set)"
fi

log ""
log "Stripe invoice import timer setup complete!"
log ""
log "Summary:"
log "  ✓ ${UNIT}.timer enabled (daily 05:20 UTC, Persistent=true catches missed runs)"
log "  ✓ Read-only against Stripe; writes stripe_invoice_history and nothing else"
log "  ✓ Keeps the renewal ladder on Admin → Monitoring → Growth current as renewals fall due"
log ""
log "Useful commands:"
log "  • systemctl list-timers ${UNIT}.timer                              - next/last run"
log "  • cd $APP_DIR && make backfill-stripe-invoices DRY_RUN=1           - fetch + report, write nothing"
log "  • cd $APP_DIR && make backfill-stripe-invoices SINCE=2026-01-01    - limit how far back to scan"
log "  • sudo systemctl start ${UNIT}.service                             - run the import now"
log "  • journalctl -u ${UNIT} -n 50                                       - recent import logs"
log "  • cd $APP_DIR && make audit-customers EVENTS=0                     - what the dashboard now concludes"
