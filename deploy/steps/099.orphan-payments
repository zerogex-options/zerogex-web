#!/bin/bash

# ==============================================
# Step 099: Orphan-Payment Sweep Timer (systemd)
# ==============================================
#
# Installs and enables the orphan-payment timer (see
# deploy/systemd/zerogex-web-orphan-payments.{service,timer}). It fires daily at
# 06:40 and runs `make orphan-payment-alerts`, which walks Stripe's paid
# invoices, keeps the ones whose customer is sitting on a free tier locally, and
# emails the operator about anything NEW.
#
# WHY: scan-orphan-payments could already find these. It printed them to a
# terminal nobody was watching, on no schedule at all. Its own header says what
# that costs — "a stranded member sees a Public account, assumes the payment
# failed like the five dunning emails said, and quietly stops showing up."
#
# It became urgent when the dunning emails started carrying Stripe's hosted
# invoice link. That link is right to send: it is the only way a member can
# settle an invoice on any card the moment they have the money. But it also
# makes it far easier to pay an invoice whose period has already elapsed, and
# that is precisely the payment that lands with no entitlement attached. Making
# the path easier without watching it would have been the worst of both.
#
# DETECTION ONLY. The timer cannot change a tier, issue a refund, or decide
# whether an elapsed period should be granted afresh — that last one is a
# pricing decision and stays with a human. Every command in the email is a dry
# run until YES=1 is added.
#
# Idempotent — safe to re-run. Unit files are overwritten from the repo.
#
# DB-dir RW: this sweep is read-only about members but WRITES one thing, the
# `orphan_payment_alert_sent` audit row that stops a standing problem being
# re-alerted every morning. The base unit lists the two known DB locations with
# a leading '-'; a custom AUTH_DB_PATH gets a drop-in below.
#
# FIRST INSTALL: the first tick alerts on everything currently outstanding in
# the 120-day window, as one email. Check what that will be BEFORE enabling:
#   cd ~/zerogex-web && make orphan-payment-alerts DRY_RUN=1

set -e

if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER:-}" != "root" ]; then
    STEP_SUDO_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    [ -n "$STEP_SUDO_HOME" ] && export HOME="$STEP_SUDO_HOME"
fi
[ -z "${HOME:-}" ] && export HOME="/home/ubuntu"

type log >/dev/null 2>&1 || log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

log "Orphan-Payment Sweep Timer Setup"

APP_DIR="$HOME/zerogex-web"
SYSTEMD_SOURCE="$APP_DIR/deploy/systemd"
SYSTEMD_TARGET="/etc/systemd/system"
UNIT="zerogex-web-orphan-payments"
ENV_FILE="$APP_DIR/frontend/.env.local"

# --- Preconditions ---------------------------------------------------
if [ ! -d "$SYSTEMD_SOURCE" ]; then
    log "  ✗ systemd source dir not found: $SYSTEMD_SOURCE"
    exit 1
fi
for f in "${UNIT}.service" "${UNIT}.timer"; do
    if [ ! -f "$SYSTEMD_SOURCE/$f" ]; then
        log "  ✗ missing unit file: $SYSTEMD_SOURCE/$f"
        exit 1
    fi
done

if [ -s "$HOME/.nvm/nvm.sh" ]; then
    log "  ✓ nvm present at $HOME/.nvm/nvm.sh"
else
    log "  ✗ nvm not found at $HOME/.nvm/nvm.sh — run step 020.nodejs first"
    exit 1
fi

# The script reads and writes the auth DB through the sqlite3 CLI, not
# node:sqlite, so the binary is a hard requirement rather than a nicety.
if command -v sqlite3 >/dev/null 2>&1; then
    log "  ✓ sqlite3 CLI present"
else
    log "  ✗ sqlite3 CLI not found — install with: sudo apt-get install -y sqlite3"
    exit 1
fi

# --- Env soft-check --------------------------------------------------
read_env() {
    grep -E "^$1=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'"
}
warn_missing_env() {
    if [ -z "$(read_env "$1")" ]; then
        log "  ⚠ $1 is unset in $ENV_FILE — timer will install but runs error until set"
    else
        log "  ✓ $1 is set"
    fi
}
if [ -f "$ENV_FILE" ]; then
    warn_missing_env STRIPE_SECRET_KEY
    warn_missing_env RESEND_API_KEY
    warn_missing_env RESEND_FROM_EMAIL
    if [ -z "$(read_env ORPHAN_ALERT_EMAIL)" ] \
       && [ -z "$(read_env CANCELLATION_ALERT_EMAIL)" ] \
       && [ -z "$(read_env SIGNUP_ALARM_EMAIL)" ] \
       && [ -z "$(read_env FOH_REMINDER_EMAIL)" ]; then
        log "  ⚠ no alert recipient set (ORPHAN_ALERT_EMAIL / CANCELLATION_ALERT_EMAIL / SIGNUP_ALARM_EMAIL / FOH_REMINDER_EMAIL)"
    else
        log "  ✓ alert recipient resolvable"
    fi
else
    log "  ⚠ $ENV_FILE not found — step 030 should have created it"
fi

# --- Install the units -----------------------------------------------
log "  → Installing ${UNIT}.{service,timer}..."
sudo cp "$SYSTEMD_SOURCE/${UNIT}.service" "$SYSTEMD_TARGET/"
sudo cp "$SYSTEMD_SOURCE/${UNIT}.timer"   "$SYSTEMD_TARGET/"

# --- DB-dir RW drop-in for a custom AUTH_DB_PATH ---------------------
DROPIN_DIR="$SYSTEMD_TARGET/${UNIT}.service.d"
AUTH_DB_PATH_VALUE="$(read_env AUTH_DB_PATH)"
if [ -n "$AUTH_DB_PATH_VALUE" ]; then
    DB_DIR="$(dirname "$AUTH_DB_PATH_VALUE")"
    case "$DB_DIR" in
        /var/lib/zerogex|"$APP_DIR/frontend/data")
            log "  ✓ AUTH_DB_PATH dir ($DB_DIR) already covered by the base unit"
            sudo rm -f "$DROPIN_DIR/10-db-readwrite.conf" 2>/dev/null || true
            ;;
        *)
            log "  → AUTH_DB_PATH dir ($DB_DIR) is custom — writing ReadWritePaths drop-in"
            sudo mkdir -p "$DROPIN_DIR"
            printf '[Service]\nReadWritePaths=%s\n' "$DB_DIR" | sudo tee "$DROPIN_DIR/10-db-readwrite.conf" >/dev/null
            ;;
    esac
else
    log "  ℹ AUTH_DB_PATH not set — script defaults to frontend/data/auth.db (covered by base unit)"
fi

sudo systemctl daemon-reload

log "  → Enabling ${UNIT}.timer (daily 06:40, Persistent=true)..."
if sudo systemctl enable --now "${UNIT}.timer" 2>/dev/null; then
    NEXT=$(systemctl list-timers --no-pager --no-legend "${UNIT}.timer" 2>/dev/null | awk '{print $1, $2}')
    log "     ✓ ${UNIT}.timer enabled (next run: ${NEXT:-unknown})"
else
    log "     ✗ ${UNIT}.timer failed to enable"
    exit 1
fi

# Deliberately NO real send here — the first tick may cover a backlog. Preview
# it with the dry run, which prints the whole email and latches nothing.

log ""
log "Orphan-payment sweep timer setup complete!"
log ""
log "Summary:"
log "  ✓ ${UNIT}.timer enabled (daily 06:40; a tick with nothing new sends no email)"
log "  ✓ Fires: ONE email covering every new finding, grouped by what to do about it"
log "  ✓ Recipient: ORPHAN_ALERT_EMAIL (falls back to CANCELLATION_ALERT_EMAIL, SIGNUP_ALARM_EMAIL, FOH_REMINDER_EMAIL)"
log "  ✓ Idempotent: each invoice is latched by an 'orphan_payment_alert_sent' audit row"
log "  ✓ Detection only: every command in the email is a dry run until YES=1"
log ""
log "Useful commands:"
log "  • cd $APP_DIR && make orphan-payment-alerts DRY_RUN=1            - print the email, send nothing, latch nothing"
log "  • cd $APP_DIR && make orphan-payment-alerts PREVIEW_TO=you@x.com - one sample, ignores the latch"
log "  • cd $APP_DIR && make scan-orphan-payments                       - the same sweep, printed, no email"
log "  • systemctl list-timers ${UNIT}.timer                            - next/last run"
log "  • journalctl -u ${UNIT} -n 50                                    - recent run logs"
