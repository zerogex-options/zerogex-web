#!/bin/bash

# ==============================================
# Step 050: Nginx Reverse Proxy (HTTP bootstrap)
# ==============================================

set -euo pipefail

log "Nginx Reverse Proxy (HTTP bootstrap)"

# Config (supports independent or co-hosted deployments)
SITE_NAME="${WEB_SITE_NAME:-zerogex-web}"
WEB_PORT="${WEB_PORT:-3000}"
API_UPSTREAM="${WEB_API_UPSTREAM:-http://127.0.0.1:8000}"
DOMAIN_NAME="${WEB_DOMAIN:-}"
CONF_PATH="/etc/nginx/sites-available/${SITE_NAME}"

if [ -z "$DOMAIN_NAME" ]; then
  read -p "  Enter your web domain (e.g., app.zerogex.io): " DOMAIN_NAME
fi

while [ -z "$DOMAIN_NAME" ]; do
  echo "     ✗ Domain cannot be empty"
  read -p "  Enter your web domain: " DOMAIN_NAME
done

log "  → Site name: $SITE_NAME"
log "  → Domain: $DOMAIN_NAME"
log "  → Frontend upstream: http://127.0.0.1:$WEB_PORT"
log "  → API/WS upstream: $API_UPSTREAM"

# Detect conflicting server_name ownership across enabled sites.
log "  → Checking for conflicting server_name ownership..."
CONFLICTS=$(sudo grep -R "server_name" /etc/nginx/sites-enabled 2>/dev/null \
  | grep -E "(^|[[:space:]])${DOMAIN_NAME}([[:space:];]|$)|(^|[[:space:]])www\.${DOMAIN_NAME}([[:space:];]|$)" \
  | grep -v "/${SITE_NAME}:" || true)

if [ -n "$CONFLICTS" ]; then
  log "  ✗ Conflict detected: another enabled nginx site already serves ${DOMAIN_NAME}"
  log "    Details:"
  while IFS= read -r line; do log "      $line"; done <<< "$CONFLICTS"
  log "    Use a distinct domain/subdomain (recommended: app.* for web, api.* for API)."
  exit 1
fi

# Shared snippets used across zerogex services (safe if co-hosted)
log "  → Ensuring shared nginx snippets exist..."
if [ ! -f /etc/nginx/conf.d/zerogex-upgrade-map.conf ]; then
  sudo tee /etc/nginx/conf.d/zerogex-upgrade-map.conf > /dev/null <<'MAPEOF'
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
MAPEOF
fi

# Always regenerate — this file is the source of truth for the shared
# limit_req_zone / limit_conn_zone declarations. The prior version had
# an `if [ ! -f ]` guard which meant a host that already had the older
# file (pre-WS, without zerogex_ws_per_ip) never picked up new zones
# on re-deploy; the /ws location block then failed nginx -t with "zero
# size shared memory zone". Idempotent by design — writing the same
# content is a no-op after nginx reload.
sudo tee /etc/nginx/conf.d/zerogex-rate-limit.conf > /dev/null <<'LIMITEOF'
# Per-IP rate limiting for app/API endpoints.
#
# rate=500r/s matches the API tier (zerogex-oa/deploy/steps/120.nginx_api),
# which writes this SAME /etc/nginx/conf.d/zerogex-rate-limit.conf — keeping the
# two in lockstep also avoids a co-hosted last-writer-wins mismatch. It is
# deliberately generous. The app polls live gamma/quote data at ~1 Hz across
# several charts, so a single open page is already several req/s and heavy views
# (e.g. Pair Comparison) run two live columns at once. Because limit_req keys on
# $binary_remote_addr, everyone behind a shared egress — corporate/VPN NAT,
# mobile CGNAT, or a CDN edge when real-IP isn't restored — collapses onto ONE
# bucket, so the previous rate=20r/s rejected ordinary multi-viewer traffic. Once
# the burst bucket drained, limit_req returned 503 (its default status), and
# because limit_req runs BEFORE proxy_cache those 503s bypass the
# use_stale/background_update masking and reach the browser — surfacing on the
# most frequent request, the gamma heatmap. The per-session response cache (5s) +
# proxy_cache_lock bound real upstream load regardless, and fail2ban handles true
# abuse, so this stays a guardrail against runaway loops, not a capacity throttle.
limit_req_zone $binary_remote_addr zone=zerogex_api_per_ip:10m rate=500r/s;
# Per-IP concurrent-connection cap for /ws. limit_req caps handshake
# rate but WS is long-lived; without limit_conn a single IP could open
# thousands of persistent sockets. 10m holds ~160k IPs.
limit_conn_zone $binary_remote_addr zone=zerogex_ws_per_ip:10m;
LIMITEOF

# Restore the real client IP when Cloudflare fronts the site.
#
# zerogex.io sits behind Cloudflare, so without this every request arrives with
# a Cloudflare edge address as $remote_addr. That collapses the entire visitor
# base onto a handful of CF IPs, which turned the per-IP limit_req above into a
# de-facto GLOBAL throttle — the direct cause of the site-wide 503 storm (tens of
# thousands of "limiting requests ..." rejections all keyed to CF ranges like
# 104.23.x / 172.69.x). It also hid the true client from fail2ban, the audit log,
# and the BFF's own request monitoring.
#
# Trusting CF-Connecting-IP from Cloudflare's published ranges makes $remote_addr
# / $binary_remote_addr the real client again — so the rate limit (and any abuse
# tooling) applies per actual user as intended. Cloudflare adds ranges from time
# to time, and a STALE allow-list would silently send those users' traffic back
# to a shared CF-edge bucket (re-creating the outage), so the list is installed
# and refreshed by a small script + weekly timer rather than baked in once.
log "  → Installing Cloudflare real-IP refresher (script + weekly timer)..."
sudo tee /usr/local/bin/zerogex-web-refresh-cf-ranges.sh > /dev/null <<'CFSCRIPT'
#!/usr/bin/env bash
# Regenerate the two Cloudflare-derived nginx snippets from CF's published ranges
# and reload nginx if either changed. Safe to run repeatedly.
#
#   /etc/nginx/conf.d/zerogex-realip.conf  — real-IP restoration (CF-Connecting-IP)
#   /etc/nginx/conf.d/zerogex-cf-geo.conf  — $zgx_from_cloudflare origin-gate map
#
# Fail-safe on every axis, because a bad map here can take the site down:
#   * a failed or SHORT fetch (fewer than MIN_RANGES CIDRs) keeps the existing
#     files — an empty gate map would 403 every visitor;
#   * only well-formed CIDR lines are emitted (non-CIDR junk is filtered);
#   * after install, `nginx -t` must pass or the previous files are restored.
# Set ZEROGEX_CF_SKIP_RELOAD=1 to write without reloading (deploy path, where the
# step's own nginx -t + restart validates the whole config).
set -euo pipefail
REALIP="/etc/nginx/conf.d/zerogex-realip.conf"
GEO="/etc/nginx/conf.d/zerogex-cf-geo.conf"
MIN_RANGES=10   # CF publishes ~22; far fewer means a bad/partial fetch
V4="$(curl -fsS --max-time 10 https://www.cloudflare.com/ips-v4 || true)"
V6="$(curl -fsS --max-time 10 https://www.cloudflare.com/ips-v6 || true)"
RANGES="$(printf '%s\n%s\n' "$V4" "$V6" | grep -E '^[0-9a-fA-F.:]+/[0-9]+$' || true)"
COUNT="$(printf '%s\n' "$RANGES" | grep -c . || true)"
if [ "$COUNT" -lt "$MIN_RANGES" ]; then
  echo "zerogex-cf-ranges: only $COUNT ranges fetched (<$MIN_RANGES); keeping existing config" >&2
  # Never leave the gate variable undefined (that would fail nginx -t) and never
  # write an empty default-0 map (that would 403 everyone). If no real map exists
  # yet, install a fail-OPEN stub so the site config loads with the gate simply
  # disabled until a good fetch replaces it. An already-good map is left as-is.
  if [ ! -f "$GEO" ]; then
    printf '%s\n' \
      '# Cloudflare origin gate — fail-open stub (CF ranges unavailable at write time).' \
      '# Gate disabled until zerogex-web-refresh-cf-ranges.sh installs the real map.' \
      'geo $realip_remote_addr $zgx_from_cloudflare { default 1; }' > "$GEO"
    echo "zerogex-cf-ranges: wrote fail-open gate stub (gate disabled for now)" >&2
  fi
  exit 0
fi
TMPR="$(mktemp)"; TMPG="$(mktemp)"; trap 'rm -f "$TMPR" "$TMPG"' EXIT
{
  echo "# Cloudflare real-IP restoration — managed by zerogex-web-refresh-cf-ranges.sh."
  echo "# Do not edit by hand; regenerated from cloudflare.com/ips-v4 + ips-v6."
  while IFS= read -r c; do [ -n "$c" ] && echo "set_real_ip_from $c;"; done <<< "$RANGES"
  echo "real_ip_header CF-Connecting-IP;"
  echo "real_ip_recursive on;"
} > "$TMPR"
{
  echo "# Cloudflare origin gate — managed by zerogex-web-refresh-cf-ranges.sh."
  echo "# \$zgx_from_cloudflare = 1 when the real TCP peer (\$realip_remote_addr,"
  echo "# i.e. BEFORE real-IP restoration) is a Cloudflare edge or localhost; 0 = a"
  echo "# direct-to-origin connection. The website server block 403s when it is 0."
  echo "geo \$realip_remote_addr \$zgx_from_cloudflare {"
  echo "    default 0;"
  echo "    127.0.0.1 1;"
  echo "    ::1 1;"
  while IFS= read -r c; do [ -n "$c" ] && echo "    $c 1;"; done <<< "$RANGES"
  echo "}"
} > "$TMPG"
changed=0
cmp -s "$TMPR" "$REALIP" 2>/dev/null || changed=1
cmp -s "$TMPG" "$GEO" 2>/dev/null || changed=1
[ "$changed" -eq 0 ] && exit 0
BR="$(mktemp)"; BG="$(mktemp)"
[ -f "$REALIP" ] && cp "$REALIP" "$BR" || true
[ -f "$GEO" ] && cp "$GEO" "$BG" || true
install -m 644 "$TMPR" "$REALIP"
install -m 644 "$TMPG" "$GEO"
if [ -n "${ZEROGEX_CF_SKIP_RELOAD:-}" ]; then
  echo "zerogex-cf-ranges: wrote realip + gate ($COUNT ranges; reload skipped)"
  rm -f "$BR" "$BG"; exit 0
fi
if nginx -t >/dev/null 2>&1; then
  systemctl reload nginx
  echo "zerogex-cf-ranges: updated realip + gate ($COUNT ranges); reloaded nginx"
  rm -f "$BR" "$BG"
else
  echo "zerogex-cf-ranges: nginx -t failed; restoring previous snippets" >&2
  if [ -s "$BR" ]; then cp "$BR" "$REALIP"; else rm -f "$REALIP"; fi
  if [ -s "$BG" ]; then cp "$BG" "$GEO"; else rm -f "$GEO"; fi
  rm -f "$BR" "$BG"
  exit 1
fi
CFSCRIPT
sudo chmod 755 /usr/local/bin/zerogex-web-refresh-cf-ranges.sh

# Generate the snippet now, without reloading — the step's own nginx -t + restart
# below validates the full config once every zone/site file is in place.
if sudo env ZEROGEX_CF_SKIP_RELOAD=1 /usr/local/bin/zerogex-web-refresh-cf-ranges.sh; then
  log "     ✓ Wrote zerogex-realip.conf + zerogex-cf-geo.conf"
else
  log "  ⚠ Could not generate the Cloudflare snippets now (fetch failed or too few"
  log "    ranges). If the site is NOT behind Cloudflare they are unnecessary;"
  log "    otherwise the weekly timer will retry. NOTE: the origin gate in the"
  log "    site config needs zerogex-cf-geo.conf to exist, so nginx -t will fail"
  log "    until a successful fetch — re-run this step once connectivity is back."
fi

# Weekly refresh so a Cloudflare range addition can't silently break real-IP.
sudo tee /etc/systemd/system/zerogex-web-refresh-cf-ranges.service > /dev/null <<'CFSVC'
[Unit]
Description=Refresh Cloudflare IP ranges for nginx real-IP restoration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/zerogex-web-refresh-cf-ranges.sh
CFSVC

sudo tee /etc/systemd/system/zerogex-web-refresh-cf-ranges.timer > /dev/null <<'CFTIMER'
[Unit]
Description=Weekly refresh of Cloudflare IP ranges for nginx real-IP

[Timer]
OnCalendar=Sun *-*-* 04:30:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
CFTIMER

sudo systemctl daemon-reload
sudo systemctl enable --now zerogex-web-refresh-cf-ranges.timer

# Website-scoped per-user rate limit — a separate zone from the shared
# zerogex_api_per_ip that the direct-to-origin API tier keys on. Now that real-IP
# restoration keys limit_req on the true client, browser traffic can be tuned
# independently of the API, and a co-hosted API deploy can't clobber it.
#
# 200r/s (vs the API's 500) leans on Cloudflare — which fronts the website and
# absorbs volumetric abuse at its own edge — so this origin limit is a secondary
# guardrail. It still keys on $binary_remote_addr, which is ONE address per NAT
# egress even after real-IP restoration (a large office/VPN behind a single
# public IP shares this bucket), so it is kept deliberately generous; burst stays
# high so a dashboard's dozens-of-requests page-load fan-out is never clipped. If
# a big shared-IP customer ever gets throttled, raise this or switch to
# per-session limiting (key on $cookie_zgx_session) instead of per-IP.
sudo tee /etc/nginx/conf.d/zerogex-web-rate-limit.conf > /dev/null <<'WEBLIMIT'
limit_req_zone $binary_remote_addr zone=zerogex_web_per_ip:10m rate=200r/s;
WEBLIMIT

# Proxy response cache. The same zone is also defined by zerogex-oa
# (deploy/steps/120.nginx_api). Whichever repo deploys first writes the
# snippet; the other skips. The cache directory is created unconditionally
# so the proxy_cache_path directive can always start cleanly.
sudo mkdir -p /var/cache/nginx/zerogex
sudo chown www-data:www-data /var/cache/nginx/zerogex

if [ ! -f /etc/nginx/conf.d/zerogex-cache-zone.conf ]; then
  sudo tee /etc/nginx/conf.d/zerogex-cache-zone.conf > /dev/null <<'CACHEEOF'
# Response cache for idempotent GETs. 5s TTL + use_stale + background_update
# keeps users on slightly-stale data when the upstream is slow or briefly down.
proxy_cache_path /var/cache/nginx/zerogex levels=1:2 keys_zone=zerogex_cache:10m
                 max_size=200m inactive=30s use_temp_path=off;
CACHEEOF
fi

# Write HTTP bootstrap config (TLS hardened config comes in step 070)
log "  → Writing HTTP bootstrap nginx config: $CONF_PATH"
sudo tee "$CONF_PATH" >/dev/null <<EOF_CONF
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME};

    # ACME challenge path for certbot
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Next.js Stripe webhook endpoint — kept separate because signature
    # verification needs the raw request body, so proxy_buffering must
    # be off here (and only here).
    location ^~ /api/webhooks/ {
        proxy_pass http://127.0.0.1:${WEB_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_request_buffering off;
        proxy_buffering off;

        proxy_connect_timeout 15s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # All /api/* requests now flow through the Next.js BFF, which
    # injects X-API-Key from server-only env (ZEROGEX_API_KEY) before
    # proxying to the FastAPI backend. nginx is no longer responsible
    # for authenticating any upstream call — the website carries its
    # own per-caller key, just like external API consumers do.
    #
    # This block intentionally covers /api/auth/*, /api/admin/*,
    # /api/billing/*, /api/account/* too (they are also Next.js route
    # handlers). The only /api/* path that needs a separate block is
    # /api/webhooks/* above, because Stripe signature verification
    # requires raw request bodies (proxy_buffering off).
    location /api/ {
        proxy_pass http://127.0.0.1:${WEB_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        # Sized for heavy historical queries (window_units=90) on 2-vCPU
        # box; the BFF is a thin pass-through, so most of this is the
        # FastAPI roundtrip behind it.
        proxy_connect_timeout 30s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;

        # Response cache. zerogex_cache zone is defined in the zerogex-oa
        # repo (deploy/steps/120.nginx_api); proxy_cache_lock collapses
        # simultaneous duplicate requests, use_stale + background_update
        # serve cached values when upstream is slow or briefly down.
        #
        # The cache key includes the caller's auth headers so a cached 200
        # from one credential is never served to a different credential
        # (or to an anonymous request). MUST stay in sync with zerogex-oa's
        # 120.nginx_api / 130.ssl blocks.
        #
        # The session cookie is included because browser callers don't send
        # an Authorization header — without it, the BFF's 401/403 deny for
        # anonymous requests to a Basic/Pro endpoint would be cached and
        # then served to a freshly-authenticated user (and vice versa) for
        # the cache TTL. Partitioning by zgx_session keeps anon and each
        # logged-in session in separate cache slots.
        proxy_cache zerogex_cache;
        proxy_cache_methods GET;
        proxy_cache_valid 200 5s;
        proxy_cache_valid 404 1s;
        proxy_cache_key "\$request_method\$request_uri\$http_authorization\$http_x_api_key\$cookie_zgx_session";
        proxy_cache_lock on;
        proxy_cache_lock_timeout 90s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        add_header X-Cache-Status \$upstream_cache_status always;

        limit_req zone=zerogex_web_per_ip burst=1000 nodelay;
    }

    # WebSocket reverse proxy. Direct to FastAPI. Auth is ticket-based
    # (short-lived HS256 JWT in ?ticket=), minted by the BFF at
    # /api/ws/ticket and verified by FastAPI with the same
    # END_USER_TOKEN_SECRET the header end-user-token path uses.
    location /ws {
        proxy_pass ${API_UPSTREAM}/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        # Suppress access logging on the handshake — the ticket JWT
        # rides in ?ticket= and access.log's combined format writes the
        # full request URI. A compromised log ship would otherwise
        # yield short-lived (60s) but real tickets. The handshake
        # response body is empty (101 upgrade) and the upgrade itself
        # is still visible in error.log if debugging is needed.
        access_log off;

        # Long-lived connections. proxy_read_timeout must exceed the
        # server-side idle window (WS_IDLE_TIMEOUT_SECONDS, default
        # 120s) with headroom; client pings every 15s keep the
        # connection warm during quiet markets.
        proxy_connect_timeout 15s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Handshake-rate cap. Per-connection limit prevents a single
        # IP from opening thousands of concurrent sockets.
        limit_req zone=zerogex_web_per_ip burst=100 nodelay;
        limit_conn zerogex_ws_per_ip 32;
    }

    # Frontend reverse proxy
    location / {
        proxy_pass http://127.0.0.1:${WEB_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_connect_timeout 15s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
EOF_CONF

log "  → Enabling site ${SITE_NAME}"
sudo ln -sfn "$CONF_PATH" "/etc/nginx/sites-enabled/${SITE_NAME}"

log "  → Testing nginx configuration"
sudo nginx -t

log "  → Restarting nginx"
sudo systemctl restart nginx
sudo systemctl enable nginx

log ""
log "Nginx bootstrap configuration complete!"
log "Summary:"
log "  ✓ Site enabled: ${SITE_NAME}"
log "  ✓ Domain: ${DOMAIN_NAME} (and www)"
log "  ✓ /api/* → Next.js BFF on :${WEB_PORT} (key injected app-side)"
log "  ✓ /ws    → ${API_UPSTREAM} (WS disabled by default)"
log "  ✓ HTTP reverse proxy active; ACME challenge path ready"
log ""
log "Action required on this host (one-time, if not already done):"
log "  • Remove the legacy nginx X-API-Key snippet — it's no longer"
log "    referenced and the API repo's deploy will delete it anyway:"
log "        sudo rm -f /etc/nginx/conf.d/zerogex-api-key*.conf"
log "        sudo systemctl reload nginx"
log ""
log "Next step:"
log "  • Run step 070 for hardened HTTPS + auto-renew"
